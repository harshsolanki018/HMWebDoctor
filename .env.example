# HMWebDoctor — Root Environment Variables Pointer
# Copy server/.env.example to server/.env and client/.env.example to client/.env for local development.

# Server Environment
# NODE_ENV=development
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/hmwebdoctor
# CLIENT_URL=http://localhost:5173

# Client Environment
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_APP_URL=http://localhost:5173
